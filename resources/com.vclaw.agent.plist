<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>              <string>com.vclaw.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/v-claw.app/Contents/MacOS/v-claw-app</string>
		<!-- Started at login, so start quietly. A launch from Finder or Spotlight
		     omits this and opens the window, which is what clicking an app icon
		     is supposed to do. -->
		<string>--background</string>
	</array>
	<key>RunAtLoad</key>          <true/>
	<key>KeepAlive</key>          <false/>
	<key>ProcessType</key>        <string>Interactive</string>
</dict>
</plist>
